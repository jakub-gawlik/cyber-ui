{
  // Type tests for the built package: resolves @jgawlik/cyber-ui through its
  // own `exports` (self-reference), so run after `npm run build`.
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["*.ts", "*.tsx"]
}
