[
  {
    "name": "all elements (JS, lit excluded)",
    "path": "dist/cyber-ui.js",
    "import": "*",
    "ignore": ["lit"],
    "limit": "14.5 kB"
  },
  {
    "name": "all elements + lit",
    "path": "dist/cyber-ui.js",
    "import": "*",
    "limit": "21 kB"
  },
  {
    "name": "one element: <cyber-modal> (lit excluded)",
    "path": "dist/components/cyber-modal.js",
    "import": "*",
    "ignore": ["lit"],
    "limit": "2 kB"
  },
  {
    "name": "one form element: <cyber-input> (lit excluded)",
    "path": "dist/components/cyber-input.js",
    "import": "*",
    "ignore": ["lit"],
    "limit": "3.2 kB"
  },
  {
    "name": "heaviest element: <cyber-select> (lit excluded)",
    "path": "dist/components/cyber-select.js",
    "import": "*",
    "ignore": ["lit"],
    "limit": "5.5 kB"
  },
  {
    "name": "global stylesheet",
    "path": "dist/cyber-ui.css",
    "rolldown": false,
    "limit": "6.5 kB"
  }
]
